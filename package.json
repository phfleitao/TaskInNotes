{
  "name": "taskinnotes",
  "version": "0.1.0",
  "description": "Your tasks, searchable in your notes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:harness": "node tests/browser/server.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "yaml": "^2.8.1" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "obsidian": "1.11.4",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": { "node": ">=22.12.0" }
}
